# ============================================================================
#  Teams AI Support Agent — Configuration
#  Copy this file to ".env" for local testing, OR set these same keys in your
#  hosting dashboard (e.g. Render → Environment). NEVER commit your real .env.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) MICROSOFT TEAMS / BOT identity
#    You get these when you register the bot (see docs/SETUP.md, Step 3).
# ---------------------------------------------------------------------------
MicrosoftAppId=
MicrosoftAppPassword=
# MultiTenant is the default and works for most cases.
# Use "SingleTenant" only if you registered a single-tenant app (then also set the tenant id).
MicrosoftAppType=MultiTenant
MicrosoftAppTenantId=

# ---------------------------------------------------------------------------
# 2) AI BRAIN (the model that thinks). Default = Google Gemini (free tier).
#    Get a free Gemini key at https://aistudio.google.com/apikey (see SETUP.md).
#    To switch brains, change AI_PROVIDER to "groq" or "openai" and fill its key.
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini

# -- Gemini (free) --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# -- Groq (free, very fast) — only needed if AI_PROVIDER=groq --
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -- OpenAI (paid) — only needed if AI_PROVIDER=openai --
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# 3) MEMORY  ("file" persists to disk locally; "upstash" persists in the cloud
#    and survives redeploys — recommended for real 24/7 use. See docs/SETUP.md.)
# ---------------------------------------------------------------------------
MEMORY_BACKEND=file
# Only needed if MEMORY_BACKEND=upstash (free at https://upstash.com):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How many recent conversation turns the agent remembers per user.
MEMORY_TURNS=12

# ---------------------------------------------------------------------------
# 4) SERVER
# ---------------------------------------------------------------------------
PORT=3978
