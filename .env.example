# ============================================================================
#  V.I.R.A.N.I. — configuration
#
#  Copy this file to ".env" for local testing, or set the same keys in your
#  hosting dashboard (Render → Environment). Never commit a real .env.
#  Only the first two sections are required to get running.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) SECURITY  (required — VIRANI can read your email, so it must be locked)
# ---------------------------------------------------------------------------
# The PIN you type once per device to sign in. Choose your own.
OWNER_PIN=246810
# Any long random string. Keeps you signed in across redeploys.
# Generate one with:  node scripts/generate-keys.js
SESSION_SECRET=

# ---------------------------------------------------------------------------
# 2) AI BRAIN  (required — free)
#    Get a free key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Alternatives — set AI_PROVIDER to "groq" or "openai" and fill the key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# 3) WHO YOU ARE  (shapes how VIRANI talks to you)
# ---------------------------------------------------------------------------
OWNER_NAME=Maaz
OWNER_TIMEZONE=Asia/Karachi
OWNER_CITY=Karachi
OWNER_LOCALE=en-GB

ASSISTANT_NAME=VIRANI
ASSISTANT_FULL_NAME=Virtual Intelligent Response Assistant & Network Interface
# The word you say out loud to summon it. Keep it lowercase.
WAKE_WORD=virani

# ---------------------------------------------------------------------------
# 4) MEMORY
#    "file"    — saved on disk. Fine locally; a free host may wipe it on deploy.
#    "upstash" — free cloud Redis, survives everything. Recommended for 24/7.
#                Sign up at https://upstash.com, create a database, copy the
#                two REST values below, then set MEMORY_BACKEND=upstash.
# ---------------------------------------------------------------------------
MEMORY_BACKEND=file
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# How many recent conversation turns VIRANI keeps in mind.
MEMORY_TURNS=20

# ---------------------------------------------------------------------------
# 5) GOOGLE  (optional — Gmail + Calendar by voice)
#    Create an OAuth client at https://console.cloud.google.com/apis/credentials
#    Type: Web application. See docs/SETUP.md step 6 for the exact clicks.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your live address, no trailing slash — e.g. https://virani.onrender.com
# Used for the OAuth redirect and for links inside notifications.
PUBLIC_URL=
# Only set this if your redirect differs from <PUBLIC_URL>/api/google/callback
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# 5b) VOICE  (optional — a far more natural, cinematic voice)
#     Default "browser" uses your device's built-in speech engine: free,
#     instant, no key. Set "elevenlabs" for the film-quality version.
#     Free tier: ~10,000 characters/month at https://elevenlabs.io
#     Voice ids: https://elevenlabs.io/app/voice-library
#     If the key is missing or the quota runs out, VIRANI automatically falls
#     back to the device voice rather than going silent.
# ---------------------------------------------------------------------------
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
# Default is "Adam" — deep and calm.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_SPEED=1
# Caps one spoken reply so a long answer cannot eat your free quota.
TTS_MAX_CHARS=900

# ---------------------------------------------------------------------------
# 6) NOTIFICATIONS  (optional — a key pair is generated automatically if blank,
#    but setting your own means notification permissions survive a data reset.
#    Generate with:  node scripts/generate-keys.js
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# 7) SCHEDULING
# ---------------------------------------------------------------------------
# How often the server checks for due reminders, in milliseconds.
SCHEDULER_INTERVAL_MS=30000
# Automatic spoken morning briefing (weather, calendar, email, news, reminders).
# Local 24-hour time, e.g. 07:30. Leave blank to turn it off — you can also
# just say "VIRANI, brief me every morning at eight".
DAILY_BRIEFING_TIME=

# ---------------------------------------------------------------------------
# 8) MICROSOFT TEAMS  (optional extra front door — leave blank to skip)
# ---------------------------------------------------------------------------
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppType=MultiTenant
MicrosoftAppTenantId=

# ---------------------------------------------------------------------------
# 9) SERVER
# ---------------------------------------------------------------------------
PORT=3978
